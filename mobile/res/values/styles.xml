<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#08080A</color>
    <color name="accent">#F07AAE</color>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="DetailTheme" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="PlayerTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
